# Supabase → Connect → ORMs → Prisma (same values work for every project in the database)
# Pooled connection (port 6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432), used to create tables at build time
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---- Embeddings: set ONE of these ----
# OpenAI text-embedding-3-small (paid) https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Free fallback when OPENAI_API_KEY is empty: Google gemini-embedding-2 https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ---- Answers: set ONE of these ----
# Claude (paid) https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=""
# Free fallback when ANTHROPIC_API_KEY is empty: https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: override the Groq model (default openai/gpt-oss-120b)
GROQ_MODEL=""
